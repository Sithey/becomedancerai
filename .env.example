# Copy to .env.local and fill in. Never commit .env.local.
# Raphael sends the values privately.
DATABASE_URL=

# Where uploaded videos are stored. Defaults to ./uploads.
UPLOAD_DIR=

# Optional. Set a random 64-character lowercase hex key on the server to enable /admin over HTTPS.
# Generate one with: node -e "process.stdout.write(require('node:crypto').randomBytes(32).toString('hex'))"
TREND_ADMIN_KEY=
